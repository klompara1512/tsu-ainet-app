rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signedIn(){return request.auth!=null;}
 function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
 function hasProfile(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
 function role(){return hasProfile()?profile().data.role:'pending';}
 function active(){return hasProfile() && profile().data.active!=false && (profile().data.approved==true || role()!='pending');}
 function admin(){return active() && role()=='admin';}
 function section(){return active() && role()=='section';}
 function trainer(){return active() && role()=='trainer';}
 function board(){return active() && role()=='board';}
 function leaders(){return admin()||section();}
 function football(){return leaders()||trainer();}
 function trainingTeam(teamId){return leaders() || (trainer() && profile().data.teamIds is list && teamId in profile().data.teamIds);}
 function editors(){return leaders()||board();}
 match /users/{uid}{
  allow create: if signedIn() && request.auth.uid==uid && request.resource.data.role=='pending' && request.resource.data.approved==false;
  allow read: if signedIn() && (request.auth.uid==uid || leaders());
  allow update,delete: if leaders();
 }
 match /invites/{id}{allow read,write:if leaders();}
 match /tasks/{id}{allow read:if active();allow write:if football()||board();}

 match /trainingBookings/{id}{
  allow read: if active();
  allow create: if active() && trainingTeam(request.resource.data.teamId) && request.resource.data.createdBy == request.auth.uid;
  allow update: if active() && trainingTeam(resource.data.teamId) && trainingTeam(request.resource.data.teamId);
  allow delete: if active() && trainingTeam(resource.data.teamId);
 }
 match /trainingSlots/{id}{
  allow read: if active();
  allow create: if active() && trainingTeam(request.resource.data.teamId) && request.resource.data.createdBy == request.auth.uid;
  allow update: if active() && trainingTeam(resource.data.teamId) && trainingTeam(request.resource.data.teamId);
  allow delete: if active() && trainingTeam(resource.data.teamId);
 }
 match /services/{id}{allow read:if active();allow write:if football()||board();}
 match /kfvMatches/{d=**}{allow read:if true;allow write:if football();}
match /oefbV12Matches/{d=**}{allow read:if true;allow write:if football();}
 match /kfvMatchReports/{d=**}{allow read:if true;allow write:if false;}
 match /kfvStandings/{d=**}{allow read:if true;allow write:if football();}
match /oefbV12Standings/{d=**}{allow read:if true;allow write:if football();}
 match /kfvSquad/{d=**}{allow read:if true;allow write:if football();}
 match /teams/{d=**}{allow read:if true;allow write:if football();}
 match /players/{d=**}{allow read:if true;allow write:if football();}
 match /events/{d=**}{allow read:if true;allow write:if football()||board();}
 match /news/{d=**}{allow read:if true;allow write:if editors();}
 match /documents/{d=**}{allow read:if active();allow write:if editors();}
 match /sponsors/{d=**}{allow read:if true;allow write:if editors();}
 match /clubPeople/{d=**}{allow read:if true;allow write:if leaders();}
 match /gallery/{d=**}{allow read:if true;allow write:if editors();}
 match /visualAssets/{d=**}{allow read:if true;allow write:if leaders();}
 match /videos/{d=**}{allow read:if true;allow write:if editors();}
 match /settings/{d=**}{allow read:if active();allow write:if leaders();}
 match /kfvClubs/{d=**}{allow read:if true;allow write:if football();}
 match /clubLogos/{id}{
  allow read: if true;
  allow create,update: if leaders()
    && request.resource.data.clubName is string
    && request.resource.data.normalizedName is string
    && request.resource.data.aliases is list
    && request.resource.data.normalizedAliases is list
    && request.resource.data.logoUrl is string
    && request.resource.data.storagePath is string
    && request.resource.data.active is bool
    && request.resource.data.schemaVersion == 1;
  allow delete: if leaders();
 }
 match /publicSnapshots/{d=**}{allow read:if true;allow write:if false;}
 match /syncStatus/{d=**}{allow read:if true;allow write:if football();}
 match /kfvSyncRuns/{d=**}{allow read:if leaders();allow write:if false;}
 match /fcmTokens/{id}{
  allow read: if leaders() || (active() && resource.data.uid == request.auth.uid);
  allow create: if active() && request.resource.data.uid == request.auth.uid;
  allow update: if active() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
  allow delete: if active() && resource.data.uid == request.auth.uid;
 }
 match /notificationQueue/{id}{allow read,write:if leaders();}
}}
